{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STORM_BUILD_TESTS": "ON",
        "STORM_BUILD_GLES": "OFF",
        "STORM_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "termux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/termux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STORM_BUILD_TESTS": "ON",
        "STORM_BUILD_GLES": "OFF",
        "STORM_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "termux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/termux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STORM_BUILD_TESTS": "ON",
        "STORM_BUILD_GLES": "OFF",
        "STORM_ENABLE_WARNINGS": "ON"
      }
    }
  ]
}
