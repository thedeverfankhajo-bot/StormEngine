# Clang 18 currently reports a false positive for Error copies returned from
# std::variant-backed Result<T>; Error::code is explicitly initialized.
# Keep all other Clang Static Analyzer checks enabled and promoted to errors.
Checks: '-*,clang-analyzer-*,-clang-analyzer-core.uninitialized.Assign'
WarningsAsErrors: 'clang-analyzer-*'
HeaderFilterRegex: '.*(engine|platforms|tests)/.*'
FormatStyle: none
